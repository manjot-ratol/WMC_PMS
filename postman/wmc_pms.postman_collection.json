 "info": {
  "name": "WMC PMS Onboarding - screens 01-25",
  "_postman_id": "7c1f1d3e-5a6b-4b0f-9f6e-wmcpms0000002",
  "description": "Runs the onboarding journey against the local backend (`make up` + `npm run start:api`).\n\nOTP delivery locally: the SMS sender only logs a masked destination, so read the phone OTP from the API log at debug level (`LOG_LEVEL=debug`, event `sms.sent` is masked; the code is NOT logged). For local testing use the Mailpit UI (http://localhost:8025) for email codes, and for phone codes run with `APP_ENV=local` and read the code from the MessageSpy via the SIT harness, or use the SIT suite (`make sit`) which drives the whole journey automatically.\n\nVariables chain automatically via test scripts: preauth_token, challenge_id, session_token, application_id, email_challenge_id.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
