 "item": [
  {
   "name": "Health",
   "item": [
    {
     "name": "GET /health",
     "request": {
      "method": "GET",
      "url": "{{baseUrl}}/health"
     }
    },
    {
     "name": "GET /health/ready",
     "request": {
      "method": "GET",
      "url": "{{baseUrl}}/health/ready"
     }
    }
   ]
  },
  {
   "name": "01 Phone challenge",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('202', () => pm.response.to.have.status(202));",
       "const b = pm.response.json(); pm.collectionVariables.set('preauth_token', b.preauth_token); pm.collectionVariables.set('challenge_id', b.challenge_id);"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{baseUrl}}/v1/auth/phone/challenges",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"purpose\": \"PMS_ONBOARDING\",\n  \"privacy_notice_version\": \"privacy_v1\"\n}"
    }
   }
  },
  {
   "name": "02 Verify phone OTP",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200', () => pm.response.to.have.status(200));",
       "const b = pm.response.json(); pm.collectionVariables.set('session_token', b.session_token); pm.collectionVariables.set('application_id', b.application_id);"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "Authorization",
      "value": "Bearer {{preauth_token}}"
     }
    ],
    "url": "{{baseUrl}}/v1/auth/phone/challenges/{{challenge_id}}/verify",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"otp\": \"{{otp}}\"\n}"
    }
   }
  },
  {
   "name": "02 Resend phone OTP",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "if (pm.response.code === 200) { pm.collectionVariables.set('challenge_id', pm.response.json().challenge_id); }"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "Authorization",
      "value": "Bearer {{preauth_token}}"
     }
    ],
    "url": "{{baseUrl}}/v1/auth/phone/challenges/{{challenge_id}}/resend",
    "body": {
     "mode": "raw",
     "raw": "{}"
    }
   }
  },
