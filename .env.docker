# Local docker-compose profile for wmc_pms (FE developers). No real partner credentials: every partner is mocked.
APP_ENV=local
PORT=3000
SERVICE_NAME=wmc-pms
LOG_LEVEL=info
INTERNAL_SERVICE_TOKEN=dev-internal-token

DATABASE_URL=postgresql://wmc:wmc@postgres:5432/wmc_pms
REDIS_URL=redis://redis:6379/0

STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio123
STORAGE_BUCKET=pms-documents
STORAGE_REGION=us-east-1
