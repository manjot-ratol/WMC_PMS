# MF Central: WireMock stand-in for the UAT API (tools/wiremock/mappings/mfcentral.json) so the local stack needs no vendor secrets.
# Real UAT: MFCENTRAL_BASE_URL=https://uatservices.mfcentral.com, MFCENTRAL_APP_URL=https://mfc-cas-uat.mfcentral.com plus the tenant
# client id/secret, username/password, encryption key, private JWK and the 32-byte URL encryption key from the vendor (never committed).
MFCENTRAL_BASE_URL=http://wiremock:8080/mfcentral
MFCENTRAL_CRYPTO_MODE=remote
MFCENTRAL_APP_URL=http://localhost:8080/mfcentral
MFCENTRAL_CLIENT_ID=local-client
MFCENTRAL_CLIENT_SECRET=local-secret
MFCENTRAL_USERNAME=local-user
MFCENTRAL_PASSWORD=local-pass
MFCENTRAL_ENCRYPTION_KEY=local-encryption-key
MFCENTRAL_PRIVATE_JWK={}
MFCENTRAL_TIMEOUT_MS=30000
MFCENTRAL_REDIRECT_URL=http://localhost:3000/v1/integrations/mfcentral/callback
# Where the browser lands after the callback stored the statement: set to the FE route (query: import_id, status)
MFCENTRAL_RETURN_URL=pmsapp://dashboard
PORTFOLIO_IMPORT_TTL_MINUTES=15
MFCENTRAL_URL_ENCRYPTION_KEY=local-url-encryption-key-32bytes

CLEVERTAP_ENABLED=false
CLEVERTAP_BASE_URL=https://in1.api.clevertap.com

SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@wmc-pms.local

FUNDING_BENEFICIARY_NAME=JIOBLACKROCK PMS POOL (LOCAL)
FUNDING_BENEFICIARY_ACCOUNT_NUMBER=123456789012
FUNDING_BENEFICIARY_IFSC=SBIN0000001
FUNDING_BENEFICIARY_BANK_NAME=LOCAL BANK
