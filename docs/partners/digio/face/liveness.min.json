{
 "servers": [
  {
   "url": "https://api.digio.in",
   "description": "Server URL in Production Environment"
  }
 ],
 "securitySchemes": {
  "api_auth": {
   "type": "http",
   "in": "header",
   "scheme": "basic"
  }
 },
 "paths": {
  "/v3/client/kyc/analyze/file/liveness": {
   "post": {
    "summary": "Liveness Check API",
    "description": "Call this API for passive liveness check from an image \n\n   - Maximum file size for a single image: 5 MB \n\n   - Maximum file size for bulk liveness checks: 500 KB per image, with a cumulative ZIP file size not exceeding 50 MB \n\n",
    "operationId": "livenessCheck",
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/LivenessCheckRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ValidationCheckResponse"
        },
        "examples": {
         "Success": {
          "description": "Success",
          "value": {
           "score": 90,
           "result": "PASS"
          }
         },
         "Failure": {
          "description": "Failure",
          "value": {
           "score": 12,
           "result": "FAIL",
           "errors": [
            "Photo of photo detected"
           ]
          }
         }
        }
       }
      }
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        },
        "examples": {
         "Bad Request": {
          "description": "Bad Request",
          "value": {
           "details": "EX23297402937402",
           "code": "REQUEST_VALIDATION_FAILED",
           "message": "Request Validation Failed"
          }
         }
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ]
   }
  }
 },
 "schemas": {
  "GenericBadRequestResponse": {
   "type": "object",
   "properties": {
    "details": {
     "type": "string",
     "description": "Details about the exception. Usually contains the exception id for reference."
    },
    "code": {
     "type": "string",
     "description": "Error code"
    },
    "message": {
     "type": "string",
     "description": "Description of the error"
    },
    "errors": {
     "type": "string",
     "description": "Custom errors"
    }
   }
  },
  "ValidationCheckResponse": {
   "type": "object",
   "properties": {
    "score": {
     "type": "number",
     "description": "Confidence of image being live or real/acceptable. Higher the better",
     "format": "double"
    },
    "result": {
     "type": "string",
     "description": "Result for the validation check (UNKNOWN is from Gray-area where manual verification can be done if you don't want customers to reattempt). Ideally consider Unknown also as Fail and ask user to reattempt.",
     "enum": [
      "PASS",
      "FAIL",
      "UNKNOWN"
     ]
    },
    "errors": {
     "type": "array",
     "description": "In case there are errors, list of errors found in image",
     "items": {
      "type": "string",
      "description": "In case there are errors, list of errors found in image"
     }
    },
    "count": {
     "type": "integer",
     "description": "Count",
     "format": "int32"
    }
   },
   "description": "Results from the checks for the back part of the ID Card"
  },
  "LivenessCheckRequest": {
   "required": [
    "image"
   ],
   "type": "object",
   "properties": {
    "image": {
     "type": "string",
     "description": "Image file in JPEG/JPG/PNG or PDF format on which the liveness check is to be performed",
     "format": "binary"
    },
    "unique_request_id": {
     "type": "string",
     "description": "Unique request id for traceability of request and recon purpose. Businesses are required to pass unique id for every request."
    }
   }
  }
 }
}