{
 "servers": [
  {
   "url": "https://api.digio.in",
   "description": "Server URL in Production Environment"
  }
 ],
 "securitySchemes": {
  "api_auth": {
   "type": "http",
   "in": "header",
   "scheme": "basic"
  }
 },
 "paths": {
  "/v3/client/kyc/facematch": {
   "post": {
    "summary": "FaceMatch API",
    "description": "Call this API to check if faces from two images match.\n\n   - Maximum file size for a single image: 5 MB\n\n   - Include supported image formats (e.g., jpg, jpeg) and note that HEIC images are not supported.\n\n",
    "operationId": "matchFaces",
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/FaceMatchRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ValidationCheckResponse"
        },
        "examples": {
         "Not Matched": {
          "description": "Not Matched",
          "value": {
           "confidence": 40,
           "result": "not_matched"
          }
         },
         "Matched": {
          "description": "Matched",
          "value": {
           "confidence": 90,
           "match_result": "matched"
          }
         },
         "Failed": {
          "description": "Failed",
          "value": {
           "confidence": 0,
           "result": "failed"
          }
         }
        }
       }
      }
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        },
        "examples": {
         "Bad Request": {
          "description": "Bad Request",
          "value": {
           "details": "EX23297402937402",
           "code": "REQUEST_VALIDATION_FAILED",
           "message": "Request Validation Failed"
          }
         }
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ]
   }
  }
 },
 "schemas": {
  "FaceMatchRequest": {
   "type": "object",
   "properties": {
    "file1": {
     "type": "string",
     "description": "Face 1 to be matched",
     "format": "binary"
    },
    "file2": {
     "type": "string",
     "description": "Face 2 to be matched with Face 1",
     "format": "binary"
    },
    "minimum_match": {
     "type": "integer",
     "description": "Minimum threshold (in percentage) for matching faces",
     "format": "int32"
    },
    "unique_request_id": {
     "type": "string",
     "description": "Unique request id for traceability of request and recon purpose. Businesses are required to pass unique id for every request."
    }
   }
  },
  "GenericBadRequestResponse": {
   "type": "object",
   "properties": {
    "details": {
     "type": "string",
     "description": "Details about the exception. Usually contains the exception id for reference."
    },
    "code": {
     "type": "string",
     "description": "Error code"
    },
    "message": {
     "type": "string",
     "description": "Description of the error"
    },
    "errors": {
     "type": "string",
     "description": "Custom errors"
    }
   }
  },
  "ValidationCheckResponse": {
   "type": "object",
   "properties": {
    "score": {
     "type": "number",
     "description": "Confidence of image being live or real/acceptable. Higher the better",
     "format": "double"
    },
    "result": {
     "type": "string",
     "description": "Result for the validation check (UNKNOWN is from Gray-area where manual verification can be done if you don't want customers to reattempt). Ideally consider Unknown also as Fail and ask user to reattempt.",
     "enum": [
      "PASS",
      "FAIL",
      "UNKNOWN"
     ]
    },
    "errors": {
     "type": "array",
     "description": "In case there are errors, list of errors found in image",
     "items": {
      "type": "string",
      "description": "In case there are errors, list of errors found in image"
     }
    },
    "count": {
     "type": "integer",
     "description": "Count",
     "format": "int32"
    }
   },
   "description": "Results from the checks for the back part of the ID Card"
  }
 }
}