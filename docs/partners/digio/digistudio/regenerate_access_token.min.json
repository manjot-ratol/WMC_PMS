{
 "servers": [
  {
   "url": "https://api.digio.in",
   "description": "Server URL in Production Environment"
  }
 ],
 "securitySchemes": {
  "api_auth": {
   "type": "http",
   "in": "header",
   "scheme": "basic"
  }
 },
 "paths": {
  "/user/auth/generate_token": {
   "post": {
    "summary": "Regenerate Access Token API",
    "description": "Regenerate Access Token API",
    "operationId": "generateGatewayToken",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/OrgGatewayTokenGenerationRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/TokenResponse"
        },
        "examples": {
         "Success": {
          "description": "Success",
          "value": {
           "id": "GWT200526102029243SP8D8SUEK59XZL",
           "created_at": "2020-05-26 10:20:29",
           "entity_id": "KID200526102029240GLYLZIMYROGYC1",
           "valid_till": "2020-05-26 10:30:29"
          }
         }
        }
       }
      }
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        },
        "examples": {
         "Bad Request": {
          "description": "Bad Request",
          "value": {
           "details": "EX23297402937402",
           "code": "REQUEST_VALIDATION_FAILED",
           "message": "Request Validation Failed"
          }
         }
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ]
   }
  }
 },
 "schemas": {
  "TokenResponse": {
   "type": "object",
   "properties": {
    "entityId": {
     "type": "string",
     "description": "Unique identifier of the parent entity the access token belongs to"
    },
    "id": {
     "type": "string",
     "description": "Unique identifier referencing an access token"
    },
    "validTill": {
     "type": "string",
     "description": "DateTime at which the access token expires. New token can be generated when expired with the access token generation API mentioned in the document.",
     "format": "date-time"
    },
    "createdAt": {
     "type": "string",
     "description": "'yyyy-mm-dd hh:mm:ss': Timestamp of generation",
     "format": "date-time"
    }
   },
   "description": "Only applicable while creating sign request when generate access token value is passes as \u201ctrue\u201d"
  },
  "GenericBadRequestResponse": {
   "type": "object",
   "properties": {
    "details": {
     "type": "string",
     "description": "Details about the exception. Usually contains the exception id for reference."
    },
    "code": {
     "type": "string",
     "description": "Error code"
    },
    "message": {
     "type": "string",
     "description": "Description of the error"
    },
    "errors": {
     "type": "string",
     "description": "Custom errors"
    }
   }
  },
  "OrgGatewayTokenGenerationRequest": {
   "required": [
    "entityId"
   ],
   "type": "object",
   "properties": {
    "entityId": {
     "type": "string",
     "description": "Unique identifier of the parent entity the access token belongs to"
    },
    "identifier": {
     "type": "string",
     "description": "Unique identifier referencing an access token"
    }
   },
   "example": " {\n    \"entity_id\" : \"KID200526102029240GLYLZIMYROGYC1\",\n}\n"
  }
 }
}