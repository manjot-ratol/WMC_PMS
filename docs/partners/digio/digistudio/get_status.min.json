     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/KycResponse"
        },
        "examples": {
         "Success": {
          "description": "Success",
          "value": {
           "request_details": {
            "id": "KID231003085119325EOAUTHCSREY35D",
            "reference_id": "CRN5420234234",
            "transaction_id": "CRN23428354029384",
            "updated_at": "2023-10-03 08:51:19",
            "created_at": "2023-10-03 08:51:19",
            "status": "requested",
            "customer_name": "Ramanand Sirvinull",
            "customer_identifier": "ramanand@digio.in"
           }
          }
         }
        }
       }
      }
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        },
        "examples": {
         "Bad Request": {
          "description": "Bad Request",
          "value": {
           "details": "EX23297402937402",
           "code": "REQUEST_VALIDATION_FAILED",
           "message": "Request Validation Failed"
          }
         }
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ]
   }
  }
