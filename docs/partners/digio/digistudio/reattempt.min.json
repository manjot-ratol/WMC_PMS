{
 "servers": [
  {
   "url": "https://api.digio.in",
   "description": "Server URL in Production Environment"
  }
 ],
 "securitySchemes": {
  "api_auth": {
   "type": "http",
   "in": "header",
   "scheme": "basic"
  }
 },
 "paths": {
  "/client/kyc/v2/request/{requestId}/reattempt": {
   "post": {
    "summary": "Reattempt some of the action",
    "description": "Reattempt some of the action",
    "operationId": "reattemptKyc",
    "parameters": [
     {
      "name": "requestId",
      "in": "path",
      "description": "Unique identifier referencing the KYC request as returned in response to request creation. (Eg. KID\u2026..)",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/KycRetryHttpRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ExternalKYCRequest"
        },
        "examples": {
         "Success": {
          "description": "Success",
          "value": {
           "id": "KID**********",
           "created_at": "2023-03-03 11:45:48",
           "updated_at": "2023-03-03 11:47:21",
           "expire_in_days": 10,
           "status": "requested",
           "customer_identifier": "email@domain.in",
           "client_reference_id": "CRN********",
           "reference_id": "CRN*******",
           "request_details": {},
           "transaction_id": "CRN**********",
           "workflow_name": "SELFIETEST",
           "show_steps": false
          }
         }
        }
       }
      }
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        },
        "examples": {
         "Bad Request": {
          "description": "Bad Request",
          "value": {
           "details": "EX23297402937402",
           "code": "REQUEST_VALIDATION_FAILED",
           "message": "Request Validation Failed"
          }
         }
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ]
   }
  }
 },
 "schemas": {
  "GenericBadRequestResponse": {
   "type": "object",
   "properties": {
    "details": {
     "type": "string",
     "description": "Details about the exception. Usually contains the exception id for reference."
    },
    "code": {
     "type": "string",
     "description": "Error code"
    },
    "message": {
     "type": "string",
     "description": "Description of the error"
    }
   }
  },
  "KycRetryHttpRequest": {
   "type": "object",
   "properties": {
    "action_ids": {
     "type": "array",
     "description": "List of action Ids to be re-requested, Action Ids can be identified from the action object on GetKyc API. (Eg. KIA\u2026..)",
     "items": {
      "type": "string",
      "description": "List of action Ids to be re-requested, Action Ids can be identified from the action object on GetKyc API. (Eg. KIA\u2026..)"
     }
    },
    "notifyCustomer": {
     "type": "boolean",
     "description": "States weather the customer should be notified."
    },
    "reason": {
     "type": "string",
     "description": "Details for customers on why they need to redo certain actions."
    }
   }
  },
  "ExternalKYCRequest": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "description": "Unique identifier referencing a request."
    },
    "createdAt": {
     "type": "string",
     "description": "Time of creation of a request.",
     "format": "date-time"
    },
    "updatedAt": {
     "type": "string",
     "description": "Time of updation of a request.",
     "format": "date-time"
    },
    "expireInDays": {
     "type": "integer",
     "description": "No. of days after which the KYC request will expire.",
     "format": "int32"
    },
    "status": {
     "type": "string",
     "description": "Status of the request. \u201crequested\u201d immediately post creation",
     "enum": [
      "requested",
      "approval_pending",
      "approved",
      "rejected",
      "failed",
      "expired",
      "skipped"
     ]
    },
    "customerIdentifier": {
     "type": "string",
     "description": "Customer email/phone number as passed in the request."
    },
    "clientReferenceId": {
     "type": "string",
     "description": "Internal reference ID as passed in the request."
    },
    "referenceId": {
     "type": "string",
     "description": "Internal reference ID as passed in the request."
    },
    "requestDetails": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "description": "Data passed in the request that is displayed on the dashboard, usually to help an agent make a decision."
     },
     "description": "Data passed in the request that is displayed on the dashboard, usually to help an agent make a decision."
    },
    "transactionId": {
     "type": "string",
     "description": "As passed in the request. Generated by the system and returned if not passed. "
    },
    "workflowName": {
     "type": "string",
     "description": "Name of the workflow."
    },
    "showSteps": {
     "type": "boolean",
     "description": "Show the steps under workflow."
    }
   }
  }
 }
}