{
 "servers": [
  {
   "url": "https://api.digio.in",
   "description": "Server URL in Production Environment"
  }
 ],
 "securitySchemes": {
  "api_auth": {
   "type": "http",
   "in": "header",
   "scheme": "basic"
  }
 },
 "paths": {
  "/client/kyc/v2/request/{requestId}/manage_approval": {
   "post": {
    "summary": "Approval/Rejection of KYC request",
    "description": "Approve or reject a KYC request",
    "operationId": "manageRequestApproval",
    "parameters": [
     {
      "name": "requestId",
      "in": "path",
      "description": "Unique identifier referencing the KYC request as returned in response to request creation. (Eg. KID\u2026..)",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/KycRequestUpdateHttpRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/KycResponse"
        },
        "examples": {
         "Success": {
          "description": "Success",
          "value": "{\n    \"id\": \"KID******\",\n    \"updated_at\": \"2023-03-06 16:21:19\",\n    \"created_at\": \"2023-03-06 16:19:30\",\n    \"status\": \"approved\",\n    \"customer_identifier\": \"customer_identifier\",\n    \"actions\": [Details of steps configured in workflow along with approved/reject status],\n    \"reference_id\": \"CRN230306161930134LE\",\n    \"request_details\": {},\n    \"transaction_id\": \"CRN230306161930134LE\",\n    \"expire_in_days\": 10,\n    \"reminder_registered\": false,\n    \"workflow_name\": \"workflow name\",\n    \"auto_approved\": false,\n    \"auditor_name\": \"Digio\",\n    \"auditor_identifier\": \"auditor identifier\"\n}\n"
         }
        }
       }
      }
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        },
        "examples": {
         "Bad Request": {
          "description": "Bad Request",
          "value": {
           "details": "EX23297402937402",
           "code": "REQUEST_VALIDATION_FAILED",
           "message": "Request Validation Failed"
          }
         }
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ]
   }
  }
 },
 "schemas": {
  "KycResponse": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "description": "Unique identifier referencing a request."
    },
    "created_at": {
     "type": "string",
     "description": "Time of creation of a request.",
     "format": "date-time"
    },
    "status": {
     "type": "string",
     "description": "Status of the request. \u201crequested\u201d immediately post creation",
     "enum": [
      "requested",
      "approval_pending",
      "approved",
      "rejected",
      "failed",
      "expired",
      "skipped"
     ]
    },
    "customer_identifier": {
     "type": "string",
     "description": "Customer email/phone number as passed in the request."
    },
    "actions": {
     "type": "array",
     "description": "LIST of details of steps configured in workflow along with approved/reject status",
     "items": {
      "$ref": "#/components/schemas/KycActionResponse"
     }
    },
    "reference_id": {
     "type": "string",
     "description": "Internal reference ID as passed in the request."
    },
    "request_details": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "description": "Data passed in the request that is displayed on the dashboard, usually to help an agent make a decision."
     },
     "description": "Data passed in the request that is displayed on the dashboard, usually to help an agent make a decision."
    },
    "transaction_id": {
     "type": "string",
     "description": "As passed in the request. Generated by the system and returned if not passed. "
    },
    "customer_name": {
     "type": "string",
     "description": "The name of the customer"
    },
    "expire_in_days": {
     "type": "integer",
     "description": "No. of days after which the KYC request will expire.",
     "format": "int32"
    },
    "reminder_registered": {
     "type": "boolean",
     "description": "States if there is any reminder registered."
    },
    "workflow_name": {
     "type": "string",
     "description": "Name of the workflow."
    },
    "auto_approved": {
     "type": "boolean",
     "description": "States weather auto approved."
    },
    "auditor_name": {
     "type": "string",
     "description": "Name of the auditor"
    },
    "auditor_identifier": {
     "type": "string",
     "description": "Unique identifier referencing auditor."
    }
   }
  },
  "KycRequestUpdateHttpRequest": {
   "required": [
    "status"
   ],
   "type": "object",
   "properties": {
    "status": {
     "type": "string",
     "enum": [
      "requested",
      "approval_pending",
      "approved",
      "rejected",
      "failed",
      "expired",
      "skipped"
     ]
    }
   }
  },
  "KycActionResponse": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "step_request_id": {
     "type": "string"
    },
    "action_ref": {
     "type": "string"
    },
    "type": {
     "type": "string",
     "enum": [
      "video",
      "image",
      "selfie",
      "aadhaar_offline",
      "two_way_video",
      "digilocker",
      "penny_drop",
      "generic",
      "document_flow",
      "fund_collection"
     ]
    },
    "status": {
     "type": "string",
     "enum": [
      "requested",
      "success",
      "approval_pending",
      "approved",
      "rejected",
      "failed",
      "expired",
      "skipped"
     ]
    },
    "file_id": {
     "type": "string"
    },
    "sub_file_id": {
     "type": "string"
    },
    "execution_request_id": {
     "type": "string"
    },
    "validation_result": {
     "type": "object",
     "additionalProperties": {
      "type": "object"
     }
    },
    "completed_at": {
     "type": "string",
     "format": "date-time"
    },
    "face_match_obj_type": {
     "type": "string",
     "enum": [
      "source",
      "match_required",
      "strict_match_required",
      "none"
     ]
    },
    "face_match_status": {
     "type": "string",
     "enum": [
      "na",
      "new",
      "halted",
      "failed",
      "done"
     ]
    },
    "obj_analysis_status": {
     "type": "string",
     "enum": [
      "na",
      "new",
      "halted",
      "failed",
      "done"
     ]
    },
    "method": {
     "type": "string",
     "enum": [
      "otp_text",
      "otp_audio",
      "otp_none"
     ]
    },
    "otp": {
     "type": "string"
    },
    "processing_done": {
     "type": "boolean"
    },
    "retry_count": {
     "type": "integer",
     "format": "int32"
    }
   },
   "description": "LIST of details of steps configured in workflow along with approved/reject status"
  },
  "GenericBadRequestResponse": {
   "type": "object",
   "properties": {
    "details": {
     "type": "string",
     "description": "Details about the exception. Usually contains the exception id for reference."
    },
    "code": {
     "type": "string",
     "description": "Error code"
    },
    "message": {
     "type": "string",
     "description": "Description of the error"
    }
   }
  }
 }
}