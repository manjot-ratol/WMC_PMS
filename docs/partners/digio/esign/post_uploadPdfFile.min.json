{
 "path": "/v2/client/document/uploadpdf",
 "method": "post",
 "summary": "Create Signature Request : JSON",
 "parameters": [],
 "requestBody": {
  "content": {
   "application/json": {
    "schema": {
     "required": [
      "file_data",
      "file_name"
     ],
     "type": "object",
     "properties": {
      "file_name": {
       "type": "string"
      },
      "will_self_sign": {
       "type": "boolean"
      },
      "signatory": {
       "type": "string"
      },
      "expire_in_days": {
       "maximum": 90,
       "minimum": 1,
       "type": "integer",
       "format": "int32",
       "default": 10
      },
      "callback": {
       "type": "string"
      },
      "comment": {
       "type": "string"
      },
      "display_on_page": {
       "type": "string",
       "enum": [
        "first",
        "last",
        "all",
        "custom"
       ],
       "default": "first"
      },
      "sign_coordinates": {
       "type": "object",
       "additionalProperties": {
        "type": "object",
        "additionalProperties": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/RectCoordinates"
         }
        }
       }
      },
      "notify_signers": {
       "type": "boolean"
      },
      "customer_notification_mode": {
       "type": "string",
       "enum": [
        "SMS",
        "WHATSAPP",
        "ALL",
        "EMAIL"
       ],
       "default": "SMS"
      },
      "signature_type": {
       "type": "string",
       "enum": [
        "dsc",
        "aadhaar",
        "external",
        "external_sign",
        "aadhaar_with_dependents",
        "electronic_with_dependents",
        "electronic",
        "document_review"
       ]
      },
      "estamp_request": {
       "type": "object",
       "properties": {
        "tags": {
         "type": "object",
         "additionalProperties": {
          "type": "integer",
          "format": "int32"
         }
        },
        "note_content": {
         "maxLength": 250,
         "pattern": "^[^<>\";=%!\\*+?]*$",
         "type": "string"
        },
        "note_on_page": {
         "type": "string",
         "enum": [
          "first",
          "last",
          "all",
          "custom"
         ],
         "default": "last"
        },
        "sign_on_page": {
         "type": "string",
         "enum": [
          "first",
          "last",
          "all",
          "custom"
         ],
         "default": "all"
        }
       }
      },
      "custom_reference": {
       "type": "string"
      },
      "reference_position": {
       "type": "string",
       "enum": [
        "TOP",
        "LEFT",
        "RIGHT"
       ],
       "default": "TOP"
      },
      "generate_access_token": {
       "type": "boolean",
       "default": false
      },
      "post_signing_receivers": {
       "maxLength": 5,
       "type": "array",
       "items": {
        "maxLength": 5,
        "required": [
         "identifier"
        ],
        "type": "object",
        "properties": {
         "identifier": {
          "type": "string"
         }
        }
       }
      },
      "signature_verification": {
       "type": "object",
       "additionalProperties": {
        "required": [
         "abortOnFail",
         "maxAttempt",
         "rules"
        ],
        "type": "object",
        "properties": {
         "abortOnFail": {
          "type": "boolean"
         },
         "maxAttempt": {
          "maximum": 3,
          "type": "integer",
          "format": "int32"
         },
         "rules": {
          "type": "array",
          "items": {
           "$ref": "#/components/schemas/ValidationRule"
          }
         }
        }
       }
      },
      "signing_condition_request": {
       "type": "object",
       "properties": {
        "conditions": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/SigningConditions"
         }
        }
       }
      },
      "include_authentication_url": {
       "type": "boolean"
      },
      "reference_id": {
       "type": "string"
      },
      "signers": {
       "type": "array",
       "items": {
        "required": [
         "identifier"
        ],
        "type": "object",
        "properties": {
         "identifier": {
          "type": "string"
         },
         "reason": {
          "maxLength": 250,
          "type": "string"
         },
         "sign_type": {
          "type": "string",
          "enum": [
           "dsc",
           "aadhaar",
           "external",
           "external_sign",
           "aadhaar_with_dependents",
           "electronic_with_dependents",
           "electronic",
           "document_review"
          ],
          "default": "aadhaar"
         },
         "signature_mode": {
          "type": "string",
          "enum": [
           "otp",
           "slate",
           "kyc",
           "otp_certified",
           "slate_certified",
           "esign_3",
           "esign_3s",
           "nesl_aadhaar_sign"
          ]
         },
         "name": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[^<>\";=%!\\*+?]*$",
          "type": "string"
         },
         "signer_tag": {
          "type": "string"
         },
         "signing_addons": {
          "type": "array",
          "example": "Geolocation Or Address of signers",
          "items": {
           "$ref": "#/components/schemas/SigningAddon"
          }
         },
         "index": {
          "type": "integer",
          "format": "int32"
         }
        }
       }
      },
      "sequential": {
       "type": "boolean",
       "default": false
      },
      "send_sign_link": {
       "type": "boolean"
      },
      "file_data": {
       "type": "string"
      },
      "require_full_document_review": {
       "type": "boolean"
      }
     },
     "example": {
      "signers": [
       {
        "identifier": "email/mobile",
        "name": "Signer Name",
        "sign_type": "aadhaar",
        "reason": "Reason for signing"
       }
      ],
      "expire_in_days": 10,
      "display_on_page": "custom",
      "notify_signers": true,
      "send_sign_link": true,
      "generate_access_token": true,
      "file_name": "Test.pdf",
      "file_data": "<base64 encoded pdf content>",
      "sign_coordinates": {
       "email/mobile": {
        "1": [
         {
          "llx": 376.55510204081634,
          "lly": 67.89677419354838,
          "urx": 535.8943577430973,
          "ury": 129.36122241086588
         }
        ]
       }
      },
      "estamp_request": {
       "tags": {
        "estamp_tag_name": "quantity"
       },
       "sign_on_page": "ALL",
       "note_content": "This is dummy content",
       "note_on_page": "ALL"
      }
     }
    }
   }
  }
