{
 "servers": [
  {
   "url": "https://api.digio.in",
   "description": "Server URL in Production Environment"
  }
 ],
 "securitySchemes": {
  "api_auth": {
   "type": "http",
   "in": "header",
   "scheme": "basic"
  }
 },
 "paths": {
  "/v4/client/verify/bank_account": {
   "post": {
    "summary": "Bank Account Verification (Penny Drop)",
    "description": "Call this API to verify bank account of your customer.",
    "operationId": "verifyBeneficiary_1",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/FundsTransferAccountVerificationRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ExternalAccountVerificationResponseV4"
        },
        "examples": {
         "Success": {
          "description": "Success",
          "value": {
           "id": "FTI1901091725336218AA5CB1LMWHM1E",
           "verified": true,
           "verified_at": "2019-01-09 17:25:39",
           "beneficiary_name_with_bank": "CUSTOMER NAME",
           "fuzzy_match_score": 49,
           "validation_mode": "PENNY_DROP"
          }
         },
         "Failure": {
          "description": "Failure",
          "value": {
           "id": "FTI1809111232556634TGAOUXJM5LLUY",
           "error_msg": "Invalid beneficiary account details",
           "verified": false
          }
         }
        }
       }
      }
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        },
        "examples": {
         "Bad Request": {
          "description": "Bad Request",
          "value": {
           "details": "EX23297402937402",
           "code": "REQUEST_VALIDATION_FAILED",
           "message": "Request Validation Failed"
          }
         }
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ]
   }
  }
 },
 "schemas": {
  "FundsTransferAccountVerificationRequest": {
   "required": [
    "beneficiary_account_no",
    "beneficiary_ifsc"
   ],
   "type": "object",
   "properties": {
    "amount": {
     "maximum": 2,
     "minimum": 1,
     "type": "number",
     "description": "Amount for the PennyDrop operation. By default: 1 rupee is credited"
    },
    "beneficiary_account_no": {
     "maxLength": 18,
     "minLength": 8,
     "type": "string",
     "description": "Bank account number that has to be verified",
     "example": "8517129000033"
    },
    "beneficiary_ifsc": {
     "type": "string",
     "description": "IFSC Code of the bank account that has to be verified",
     "example": "CNRB0008517"
    },
    "narration": {
     "type": "string",
     "description": "Optional, Narration field"
    },
    "unique_request_id": {
     "type": "string",
     "description": "Unique request id for traceability of request and recon purpose. Businesses are required to pass unique id for every request."
    },
    "beneficiary_name": {
     "type": "string",
     "description": "(Optional) Name of the bank account holder. Pass only if you want to perform a fuzzy match as part of the same request. Name match score between this and name from bank will be returned in result"
    },
    "validation_mode": {
     "type": "string",
     "enum": [
      "PENNY_LESS",
      "PENNY_DROP",
      "AUTO"
     ]
    }
   }
  },
  "GenericBadRequestResponse": {
   "type": "object",
   "properties": {
    "details": {
     "type": "string",
     "description": "Details about the exception. Usually contains the exception id for reference."
    },
    "code": {
     "type": "string",
     "description": "Error code"
    },
    "message": {
     "type": "string",
     "description": "Description of the error"
    },
    "errors": {
     "type": "string",
     "description": "Custom errors"
    }
   }
  },
  "ExternalAccountVerificationResponseV4": {
   "required": [
    "id",
    "verified",
    "verified_at"
   ],
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "description": "ID associated with the verification request",
     "example": "FTI190315135058322ZOIP27IMU18D3F"
    },
    "verified": {
     "type": "boolean",
     "description": "Verification Status (true/false)",
     "example": true
    },
    "verified_at": {
     "type": "string",
     "description": "Timestamp at which verification took place",
     "format": "date-time"
    },
    "beneficiary_name_with_bank": {
     "type": "string",
     "description": "Beneficiary Name according to the bank",
     "example": "Abhinav Parashar"
    },
    "error_msg": {
     "type": "string",
     "description": "Error Message if verification failed at bank's end"
    },
    "fuzzy_match_result": {
     "type": "boolean",
     "description": "If beneficiary_name was sent in the request, this parameter shows the result of the fuzzy match of the name",
     "example": true
    },
    "fuzzy_match_score": {
     "type": "integer",
     "description": "If beneficiary_name was sent in the request, this parameter represents the score of the name match",
     "format": "int32",
     "example": 95
    },
    "error_code": {
     "type": "string",
     "description": "Error code received during verification"
    },
    "validation_mode": {
     "type": "string",
     "description": "Account validation mode",
     "enum": [
      "PENNY_LESS",
      "PENNY_DROP",
      "AUTO"
     ]
    }
   }
  }
 }
}