{
 "servers": [
  {
   "url": "https://api.digio.in",
   "description": "Server URL in Production Environment"
  }
 ],
 "securitySchemes": {
  "api_auth": {
   "type": "http",
   "in": "header",
   "scheme": "basic"
  }
 },
 "paths": {
  "/v3/client/kyc/kra/v2/get_pan_status": {
   "post": {
    "summary": "KRA pan status",
    "description": "Call this API to get pan status",
    "operationId": "getPanStatus",
    "parameters": [
     {
      "name": "X_REFERENCE_ID",
      "in": "header",
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/KraCheckPanDetailRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PanStatusResponse"
        },
        "examples": {
         "Success": {
          "description": "Success",
          "value": {
           "pan_number": "ABJPM6976J",
           "name": "VINOD KUMAR singh",
           "status_code": "007",
           "status": "Validated",
           "status_description": "KYC details have been successfully verified. Customer can start investing. ",
           "kra_status_code": "007",
           "status_date": "02/06/2023 17:15:24",
           "entry_date": "18/06/2013 17:35:19",
           "modification_date": "10/09/2024 09:48:27",
           "update_status": "001",
           "kyc_mode": "0",
           "kyc_mode_description": "Normal KYC",
           "ipv_flag": "Y",
           "response_date": "02/06/2023 17:15:24",
           "total_records": "1",
           "ref_id": "KCA25052212000311484ETY7Q83QHQCG"
          }
         }
        }
       }
      }
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        },
        "examples": {
         "Bad Request": {
          "description": "Bad Request",
          "value": {
           "details": "EX23297402937402",
           "code": "REQUEST_VALIDATION_FAILED",
           "message": "Request Validation Failed"
          }
         }
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ]
   }
  }
 },
 "schemas": {
  "PanStatusResponse": {
   "type": "object",
   "properties": {
    "panNumber": {
     "type": "string",
     "description": "PAN of the Individual/Entity"
    },
    "name": {
     "type": "string",
     "description": "Name of the Individual/Entity"
    },
    "statusCode": {
     "type": "string",
     "description": "KYC verification status"
    },
    "status": {
     "type": "string"
    },
    "statusDescription": {
     "type": "string",
     "description": "Description of current KYC status and the KRA in which customer's KYA record last updated"
    },
    "kraStatusCode": {
     "type": "string",
     "description": "KYC verification status sent by KRA"
    },
    "statusDate": {
     "type": "string",
     "description": "This field will contain date of the Application status and cannot be null. For example -if Application is submitted on 17- Jan 2013 and the date of exchange is 17 the Jan 2013, then the status date will be 17th- Jan 2013 and will be equal to APP_ENTRY DATE.: No Dummy dates"
    },
    "entryDate": {
     "type": "string",
     "description": "Date when KYC was first recorded"
    },
    "modificationDate": {
     "type": "string",
     "description": "Last modification date of the KYC"
    },
    "statusDelta": {
     "type": "string"
    },
    "updateStatus": {
     "type": "string",
     "description": "Update status for KYC modifications"
    },
    "updateStatusDescription": {
     "type": "string",
     "description": "Description of current update status"
    },
    "holdDeactivationRemarks": {
     "type": "string",
     "description": "Reason for deactivation (if applicable)"
    },
    "updateRemarks": {
     "type": "string",
     "description": "Modification hold / reject remarks. Any recent updates made to KYC"
    },
    "kycMode": {
     "type": "string",
     "description": "Mode of KYC completion (0-5). e-KYC is applicable only for New Individual KYC"
    },
    "kycModeDescription": {
     "type": "string"
    },
    "ipvFlag": {
     "type": "string",
     "description": "In-Person Verification Flag (Y/N/E)"
    },
    "uboFlag": {
     "type": "string",
     "description": "Ultimate Beneficiary Owner. Y (Yes) / N (No)"
    },
    "permanentAddressProof": {
     "type": "string"
    },
    "correspondenceAddressProof": {
     "type": "string"
    },
    "batchId": {
     "type": "string",
     "description": "Batch date and time"
    },
    "responseDate": {
     "type": "string"
    },
    "totalRecords": {
     "type": "string"
    },
    "signFlag": {
     "type": "string",
     "description": "Signature Flag ( By CAMS)\nY - Signature uploaded by Investor\nN - Signature not uploaded by Investor"
    },
    "refId": {
     "type": "string",
     "description": "Unique response number for tracking"
    }
   }
  },
  "KraCheckPanDetailRequest": {
   "required": [
    "pan_no"
   ],
   "type": "object",
   "properties": {
    "pan_no": {
     "type": "string",
     "description": "Pan Number of the Individual/Entity"
    },
    "dob": {
     "type": "string",
     "description": "Date of Birth of the Individual / Date of Incorporation in case of Entity",
     "format": "DD/MM/YYYY"
    },
    "fetch_type": {
     "type": "string",
     "description": "Fetch Type accepted values are I and E",
     "enum": [
      "I",
      "E"
     ]
    },
    "unique_request_id": {
     "type": "string",
     "description": "Unique request id for traceability of request and recon purpose. Businesses are required to pass unique id for every request."
    },
    "service_provider": {
     "type": "string",
     "description": "kra service provider",
     "enum": [
      "NDML",
      "CDSL",
      "CAMS"
     ]
    },
    "mobile": {
     "type": "string",
     "description": "Mobile number"
    }
   }
  },
  "GenericBadRequestResponse": {
   "type": "object",
   "properties": {
    "details": {
     "type": "string",
     "description": "Details about the exception. Usually contains the exception id for reference."
    },
    "code": {
     "type": "string",
     "description": "Error code"
    },
    "message": {
     "type": "string",
     "description": "Description of the error"
    },
    "errors": {
     "type": "string",
     "description": "Custom errors"
    }
   }
  }
 }
}