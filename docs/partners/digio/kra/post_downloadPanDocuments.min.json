{
 "servers": [
  {
   "url": "https://api.digio.in",
   "description": "Server URL in Production Environment"
  }
 ],
 "securitySchemes": {
  "api_auth": {
   "type": "http",
   "in": "header",
   "scheme": "basic"
  }
 },
 "paths": {
  "/v3/client/kyc/kra/download_document": {
   "post": {
    "summary": "Download KRA PAN documents",
    "description": "Downloads the PAN-related documents as an octet stream if available, or returns an error response in JSON.\n\n **Note:** You must provide either dob or ref_no. Both are not required.",
    "operationId": "downloadPanDocuments",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DownloadKraFilesRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful download of PAN document",
      "content": {
       "application/octet-stream": {
        "schema": {
         "type": "string",
         "description": "In response you get a zip file, containing complete KRA Documents - KRA Application, Proof of Address, Proof of Identity, Customer\u2019s Photo, Signature etc",
         "format": "binary"
        },
        "examples": {
         "File Stream": {
          "description": "File Stream",
          "value": "Binary file (PDF/ZIP)"
         }
        }
       }
      }
     },
     "400": {
      "description": "Bad Request (e.g., missing input)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        },
        "examples": {
         "Missing DOB": {
          "description": "Missing DOB",
          "value": {
           "details": "EX2507221457346984Q3",
           "code": "BAD_REQUEST",
           "message": "DOB cannot be empty if ref_no is not passed"
          }
         },
         "Missing PAN": {
          "description": "Missing PAN",
          "value": {
           "details": "EX25072214583907057P",
           "code": "BAD_REQUEST",
           "message": "Pan number cannot be empty"
          }
         }
        }
       }
      }
     },
     "404": {
      "description": "No documents found for download",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        },
        "examples": {
         "Documents Not Found": {
          "description": "Documents Not Found",
          "value": {
           "details": "EX25072214585618039M",
           "code": "ENTITY_NOT_FOUND",
           "message": "Documents not found for download"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "Internal Server Error or downstream KRA failure",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GenericBadRequestResponse"
        },
        "examples": {
         "KRA Empty Response": {
          "description": "KRA Empty Response",
          "value": {
           "details": "EX250722150053996P8Y",
           "code": "SYSTEM_ERROR",
           "message": "KRA Provided Empty Response. It could be because of wrong Date of Birth stored at KRA's end. Please contact the KRA. Do not raise modification request before fetching full data."
          }
         },
         "Invalid Reference": {
          "description": "Invalid Reference",
          "value": {
           "details": "EX250722145815275U6N",
           "code": "SYSTEM_ERROR",
           "message": "Invalid reference number / reference number already consumed"
          }
         }
        }
       }
      }
     }
    },
    "security": [
     {
      "api_auth": []
     }
    ]
   }
  }
 },
 "schemas": {
  "DownloadKraFilesRequest": {
   "required": [
    "pan_no"
   ],
   "type": "object",
   "properties": {
    "pan_no": {
     "type": "string",
     "description": "PAN number of the user."
    },
    "dob": {
     "type": "string",
     "description": "Date of birth in DD-MM-YYYY format. Required if `ref_no` is not provided"
    },
    "ref_no": {
     "type": "string",
     "description": "KRA reference number. **Required if dob is not provided.** Use internal_reference from download_pan API."
    },
    "kraCode": {
     "type": "string",
     "description": "CVLKRA \u2192 CVL KRA\n\nNDML\t\t \u2192 NDML KRA\n\nDOTEX\t\t \u2192 Dotex KRA\n\nCAMS\t\t \u2192 CAMS KRA\n\nKARVY\t\t \u2192 KARVY KRA\n\nBSE\t\t \u2192 BSE KRA\n\n"
    },
    "serviceProvider": {
     "type": "string",
     "description": "kra service provider",
     "enum": [
      "NDML",
      "CDSL",
      "CAMS"
     ]
    }
   }
  },
  "GenericBadRequestResponse": {
   "type": "object",
   "properties": {
    "details": {
     "type": "string",
     "description": "Details about the exception. Usually contains the exception id for reference."
    },
    "code": {
     "type": "string",
     "description": "Error code"
    },
    "message": {
     "type": "string",
     "description": "Description of the error"
    },
    "errors": {
     "type": "string",
     "description": "Custom errors"
    }
   }
  }
 }
}