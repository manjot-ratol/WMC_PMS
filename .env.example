# Digio environment. Sandbox: https://ext.digio.in:444  Production: https://api.digio.in
DIGIO_BASE_URL=https://ext.digio.in:444
# Digio API credentials (Basic auth: client_id:client_secret). Use sandbox or production pair to match DIGIO_BASE_URL.
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
# Optional: request timeout in milliseconds (default 30000)
DIGIO_TIMEOUT_MS=30000
# Optional: default KRA service provider sent when a request does not specify one (NDML | CDSL | CAMS)
DIGIO_KRA_DEFAULT_SERVICE_PROVIDER=

PORT=3000
