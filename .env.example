# ---- app ----
APP_ENV=local                      # local | test | production
PORT=3000
SERVICE_NAME=wmc-pms
LOG_LEVEL=debug
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# ---- data stores (docker compose defaults) ----
DATABASE_URL=postgresql://wmc:wmc@localhost:5432/wmc_pms
REDIS_URL=redis://localhost:6380/0

# ---- object storage (MinIO locally) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio123
STORAGE_BUCKET=pms-documents
STORAGE_REGION=us-east-1
UPLOAD_URL_TTL_SECONDS=300

# ---- auth / otp ----
SESSION_TTL_SECONDS=1800
PREAUTH_TTL_SECONDS=600
OTP_TTL_SECONDS=300
OTP_RESEND_AFTER_SECONDS=30
OTP_MAX_ATTEMPTS=5

# ---- crypto (base64, 32 bytes each; generate with: openssl rand -base64 32) ----
FIELD_ENCRYPTION_KEY_ID=k1
FIELD_ENCRYPTION_KEY=
FINGERPRINT_HMAC_KEY=
OTP_HMAC_KEY=

# ---- Digio (sandbox https://ext.digio.in:444, prod https://api.digio.in) ----
DIGIO_BASE_URL=https://ext.digio.in:444
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_TIMEOUT_MS=30000
DIGIO_WEBHOOK_SECRET=
DIGIO_KYC_TEMPLATE_NAME=PMS_KYC_V1

# ---- TrackWizz AS501 ----
TRACKWIZZ_BASE_URL=
TRACKWIZZ_API_TOKEN=
TRACKWIZZ_CLUSTER=CL1_User
TRACKWIZZ_DOMAIN=
TRACKWIZZ_SOURCE_SYSTEM_NAME=
TRACKWIZZ_OUR_PRIVATE_KEY_PEM=
TRACKWIZZ_THEIR_PUBLIC_KEY_PEM=
TRACKWIZZ_TIMEOUT_MS=30000
# JSON overrides for the envelope once vendor test vectors are available, e.g. {"cipher":"aes-128-cbc","sessionKeyBytes":16,"iv":"prefixed","rsaPadding":"oaep-sha1"}
TRACKWIZZ_CRYPTO_PROFILE=
# PEMs may be given with literal \n escapes. Local mock: `npm run mock:trackwizz` with test/fixtures/trackwizz keys.

# ---- MF Central ----
MFCENTRAL_BASE_URL=https://uatservices.mfcentral.com
MFCENTRAL_CLIENT_ID=
MFCENTRAL_CLIENT_SECRET=
MFCENTRAL_USERNAME=
MFCENTRAL_PASSWORD=
MFCENTRAL_ENCRYPTION_KEY=
MFCENTRAL_PRIVATE_JWK=
MFCENTRAL_TIMEOUT_MS=30000

# ---- CleverTap ----
CLEVERTAP_ENABLED=false
CLEVERTAP_BASE_URL=https://in1.api.clevertap.com
CLEVERTAP_ACCOUNT_ID=
CLEVERTAP_PASSCODE=

# ---- messaging (Mailpit locally) ----
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@wmc-pms.local

# ---- phase 6: signing + funding ----
DIGIO_ESIGN_SIGN_TYPE=aadhaar
DIGIO_ESIGN_EXPIRE_DAYS=10
FUNDING_BENEFICIARY_NAME=PLACEHOLDER PMS POOL ACCOUNT
FUNDING_BENEFICIARY_ACCOUNT_NUMBER=000000000000
FUNDING_BENEFICIARY_IFSC=XXXX0000000
FUNDING_BENEFICIARY_BANK_NAME=PLACEHOLDER BANK
MFCENTRAL_CRYPTO_MODE=remote   # remote = MF Central /api/test helpers (as in the UAT collection); local = JWS + AES placeholder, unverified
MFCENTRAL_APP_URL=https://mfc-cas-uat.mfcentral.com
# Screen 06A: browser-facing callback MF Central returns to (must be whitelisted by MF Central) and the FE page we redirect to afterwards.
# UAT rules (verified): mobile OR email in the CAS request, unique clientRefNo, bare JWS as `signature` (the helper wraps it in {"x-jws-signature"}).
MFCENTRAL_REDIRECT_URL=http://localhost:3000/v1/integrations/mfcentral/callback
MFCENTRAL_RETURN_URL=http://localhost:5173/onboarding/portfolio-import
PORTFOLIO_IMPORT_TTL_MINUTES=15
# 32-byte URL encryption key from MF Central (hand-off payload, AES-256-CBC)
MFCENTRAL_URL_ENCRYPTION_KEY=
# UAT only (boot refuses it when APP_ENV=production): MF Central's test PANs accept only their registered test mobile (+919239874560);
# set it so every CAS request carries that mobile while the onboarding journey keeps using any phone.
MFCENTRAL_TEST_MOBILE_OVERRIDE=
# Local stand-in without vendor secrets: MFCENTRAL_BASE_URL=http://localhost:8080/mfcentral (WireMock stubs, see tools/wiremock/mappings/mfcentral.json)
