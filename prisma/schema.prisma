// Phase 1: reliability tables. Business schemas arrive with their phases.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["reliability", "identity", "onboarding"]
}

enum InboxStatus {
  RECEIVED
  PROCESSED
  FAILED

  @@schema("reliability")
}

enum ActorType {
  CUSTOMER
  SYSTEM
  REVIEWER
  PARTNER

  @@schema("reliability")
}

model BusinessOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  correlationId String    @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([dispatchedAt, createdAt])
  @@map("business_outbox")
  @@schema("reliability")
}

model AnalyticsOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  eventName     String    @map("event_name")
  identity      String?
  properties    Json
  correlationId String    @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([dispatchedAt, createdAt])
  @@map("analytics_outbox")
  @@schema("reliability")
}

model IntegrationInbox {
  id            String      @id @default(uuid()) @db.Uuid
  provider      String
  eventKey      String      @map("event_key")
  payload       Json
  status        InboxStatus @default(RECEIVED)
  correlationId String      @map("correlation_id")
  receivedAt    DateTime    @default(now()) @map("received_at") @db.Timestamptz
  processedAt   DateTime?   @map("processed_at") @db.Timestamptz
  lastError     String?     @map("last_error")

  @@unique([provider, eventKey])
  @@map("integration_inbox")
  @@schema("reliability")
}

model IdempotencyRecord {
  principalId  String   @map("principal_id")
  route        String
  key          String
  requestHash  String   @map("request_hash")
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt    DateTime @map("expires_at") @db.Timestamptz

  @@id([principalId, route, key])
  @@index([expiresAt])
  @@map("idempotency_records")
  @@schema("reliability")
}

model AuditEvent {
  id            BigInt    @id @default(autoincrement())
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  actorType     ActorType @map("actor_type")
  actorId       String?   @map("actor_id")
  action        String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  correlationId String    @map("correlation_id")
  details       Json?

  @@index([aggregateType, aggregateId, occurredAt])
  @@map("audit_events")
  @@schema("reliability")
}

// ---------------- identity ----------------

enum CustomerState {
  UNVERIFIED
  VERIFIED

  @@schema("identity")
}

model Customer {
  id               String        @id
  phoneCiphertext  Bytes         @map("phone_ciphertext")
  phoneFingerprint String        @unique @map("phone_fingerprint")
  phoneVerifiedAt  DateTime?     @map("phone_verified_at") @db.Timestamptz
  emailCiphertext  Bytes?        @map("email_ciphertext")
  emailFingerprint String?       @map("email_fingerprint")
  emailVerifiedAt  DateTime?     @map("email_verified_at") @db.Timestamptz
  state            CustomerState @default(UNVERIFIED)
  version          Int           @default(0)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([emailFingerprint])
  @@map("customers")
  @@schema("identity")
}

model AuthChallenge {
  id                String    @id
  channel           String
  purpose           String
  targetFingerprint String    @map("target_fingerprint")
  customerId        String?   @map("customer_id")
  applicationId     String?   @map("application_id")
  status            String
  maxAttempts       Int       @map("max_attempts")
  createdAt         DateTime  @map("created_at") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  resendAfter       DateTime  @map("resend_after") @db.Timestamptz
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz
  correlationId     String    @map("correlation_id")

  @@index([targetFingerprint, createdAt])
  @@map("auth_challenges")
  @@schema("identity")
}

model Session {
  id         String    @id
  tokenHash  String    @unique @map("token_hash")
  customerId String    @map("customer_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  @@index([customerId])
  @@map("sessions")
  @@schema("identity")
}

// ---------------- onboarding ----------------

model OnboardingApplication {
  id             String            @id
  customerId     String            @map("customer_id")
  status         String
  journeyVersion String            @map("journey_version")
  nextScreen     String            @map("next_screen")
  version        Int               @default(0)
  createdAt      DateTime          @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  steps          ApplicationStep[]

  @@index([customerId, status])
  @@map("onboarding_applications")
  @@schema("onboarding")
}

model ApplicationStep {
  applicationId String                @map("application_id")
  stepId        String                @map("step_id")
  status        String
  version       Int
  completedAt   DateTime?             @map("completed_at") @db.Timestamptz
  application   OnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([applicationId, stepId])
  @@map("application_steps")
  @@schema("onboarding")
}

model EligibilityDecision {
  id                    String   @id
  applicationId         String   @map("application_id")
  version               Int
  customerType          String   @map("customer_type")
  residentialStatus     String   @map("residential_status")
  intendedInvestmentInr BigInt   @map("intended_investment_inr")
  distributionRoute     String   @map("distribution_route")
  status                String
  rulesetVersion        String   @map("ruleset_version")
  journeyRoute          String?  @map("journey_route")
  reasons               Json
  decidedAt             DateTime @map("decided_at") @db.Timestamptz

  @@unique([applicationId, version])
  @@map("eligibility_decisions")
  @@schema("onboarding")
}
