// Phase 1: reliability tables. Business schemas arrive with their phases.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["reliability", "identity", "onboarding", "compliance"]
}

enum InboxStatus {
  RECEIVED
  PROCESSED
  FAILED

  @@schema("reliability")
}

enum ActorType {
  CUSTOMER
  SYSTEM
  REVIEWER
  PARTNER

  @@schema("reliability")
}

model BusinessOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  correlationId String    @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([dispatchedAt, createdAt])
  @@map("business_outbox")
  @@schema("reliability")
}

model AnalyticsOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  eventName     String    @map("event_name")
  identity      String?
  properties    Json
  correlationId String    @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([dispatchedAt, createdAt])
  @@map("analytics_outbox")
  @@schema("reliability")
}

model IntegrationInbox {
  id            String      @id @default(uuid()) @db.Uuid
  provider      String
  eventKey      String      @map("event_key")
  payload       Json
  status        InboxStatus @default(RECEIVED)
  correlationId String      @map("correlation_id")
  receivedAt    DateTime    @default(now()) @map("received_at") @db.Timestamptz
  processedAt   DateTime?   @map("processed_at") @db.Timestamptz
  lastError     String?     @map("last_error")

  @@unique([provider, eventKey])
  @@map("integration_inbox")
  @@schema("reliability")
}

model IdempotencyRecord {
  principalId  String   @map("principal_id")
  route        String
  key          String
  requestHash  String   @map("request_hash")
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt    DateTime @map("expires_at") @db.Timestamptz

  @@id([principalId, route, key])
  @@index([expiresAt])
  @@map("idempotency_records")
  @@schema("reliability")
}

model AuditEvent {
  id            BigInt    @id @default(autoincrement())
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  actorType     ActorType @map("actor_type")
  actorId       String?   @map("actor_id")
  action        String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  correlationId String    @map("correlation_id")
  details       Json?

  @@index([aggregateType, aggregateId, occurredAt])
  @@map("audit_events")
  @@schema("reliability")
}

// ---------------- identity ----------------

enum CustomerState {
  UNVERIFIED
  VERIFIED

  @@schema("identity")
}

model Customer {
  id               String        @id
  phoneCiphertext  Bytes         @map("phone_ciphertext")
  phoneFingerprint String        @unique @map("phone_fingerprint")
  phoneVerifiedAt  DateTime?     @map("phone_verified_at") @db.Timestamptz
  emailCiphertext  Bytes?        @map("email_ciphertext")
  emailFingerprint String?       @map("email_fingerprint")
  emailVerifiedAt  DateTime?     @map("email_verified_at") @db.Timestamptz
  state            CustomerState @default(UNVERIFIED)
  version          Int           @default(0)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([emailFingerprint])
  @@map("customers")
  @@schema("identity")
}

model AuthChallenge {
  id                String    @id
  channel           String
  purpose           String
  targetFingerprint String    @map("target_fingerprint")
  customerId        String?   @map("customer_id")
  applicationId     String?   @map("application_id")
  status            String
  maxAttempts       Int       @map("max_attempts")
  createdAt         DateTime  @map("created_at") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  resendAfter       DateTime  @map("resend_after") @db.Timestamptz
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz
  correlationId     String    @map("correlation_id")

  @@index([targetFingerprint, createdAt])
  @@map("auth_challenges")
  @@schema("identity")
}

model Session {
  id         String    @id
  tokenHash  String    @unique @map("token_hash")
  customerId String    @map("customer_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  @@index([customerId])
  @@map("sessions")
  @@schema("identity")
}

// ---------------- onboarding ----------------

model OnboardingApplication {
  id             String            @id
  customerId     String            @map("customer_id")
  status         String
  journeyVersion String            @map("journey_version")
  nextScreen     String            @map("next_screen")
  version        Int               @default(0)
  createdAt      DateTime          @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  steps          ApplicationStep[]

  @@index([customerId, status])
  @@map("onboarding_applications")
  @@schema("onboarding")
}

model ApplicationStep {
  applicationId String                @map("application_id")
  stepId        String                @map("step_id")
  status        String
  version       Int
  completedAt   DateTime?             @map("completed_at") @db.Timestamptz
  application   OnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([applicationId, stepId])
  @@map("application_steps")
  @@schema("onboarding")
}

model EligibilityDecision {
  id                    String   @id
  applicationId         String   @map("application_id")
  version               Int
  customerType          String   @map("customer_type")
  residentialStatus     String   @map("residential_status")
  intendedInvestmentInr BigInt   @map("intended_investment_inr")
  distributionRoute     String   @map("distribution_route")
  status                String
  rulesetVersion        String   @map("ruleset_version")
  journeyRoute          String?  @map("journey_route")
  reasons               Json
  decidedAt             DateTime @map("decided_at") @db.Timestamptz

  @@unique([applicationId, version])
  @@map("eligibility_decisions")
  @@schema("onboarding")
}

// ---------------- onboarding: identity, kyc, documents, ipv (phase 3) ----------------

model IdentityVersion {
  applicationId     String   @map("application_id")
  version           Int
  panCiphertext     Bytes    @map("pan_ciphertext")
  panFingerprint    String   @map("pan_fingerprint")
  legalName         String   @map("legal_name")
  dateOfBirth       DateTime @map("date_of_birth") @db.Date
  permissionVersion String   @map("permission_version")
  status            String
  submittedAt       DateTime @map("submitted_at") @db.Timestamptz

  @@id([applicationId, version])
  @@index([panFingerprint])
  @@map("identity_versions")
  @@schema("onboarding")
}

model KycRecord {
  id                 String    @id
  applicationId      String    @map("application_id")
  identityVersion    Int       @map("identity_version")
  provider           String
  status             String
  route              String?
  operationId        String    @map("operation_id")
  version            Int       @default(0)
  summary            Json?
  evidenceKey        String?   @map("evidence_key")
  ipvExemptionBasis  String?   @map("ipv_exemption_basis")
  safeErrorCategory  String?   @map("safe_error_category")
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([applicationId, identityVersion])
  @@index([applicationId])
  @@map("kyc_records")
  @@schema("onboarding")
}

model KycSession {
  id                 String    @id
  applicationId      String    @map("application_id")
  provider           String
  providerRequestId  String?   @map("provider_request_id")
  templateName       String    @map("template_name")
  status             String
  lastProviderStatus String?   @map("last_provider_status")
  pollCount          Int       @default(0) @map("poll_count")
  safeErrorCategory  String?   @map("safe_error_category")
  evidenceKey        String?   @map("evidence_key")
  createdAt          DateTime  @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  completedAt        DateTime? @map("completed_at") @db.Timestamptz

  @@index([applicationId, status])
  @@index([providerRequestId])
  @@map("kyc_sessions")
  @@schema("onboarding")
}

model DocumentUpload {
  id                  String   @id
  applicationId       String   @map("application_id")
  requirementId       String   @map("requirement_id")
  objectKey           String   @map("object_key")
  declaredContentType String   @map("declared_content_type")
  declaredSizeBytes   Int      @map("declared_size_bytes")
  status              String
  expiresAt           DateTime @map("expires_at") @db.Timestamptz
  createdAt           DateTime @map("created_at") @db.Timestamptz

  @@index([applicationId])
  @@map("document_uploads")
  @@schema("onboarding")
}

model Document {
  id                String   @id
  applicationId     String   @map("application_id")
  requirementId     String   @map("requirement_id")
  documentType      String   @map("document_type")
  files             Json
  status            String
  operationId       String   @map("operation_id")
  safeErrorCategory String?  @map("safe_error_category")
  createdAt         DateTime @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([applicationId, requirementId])
  @@map("documents")
  @@schema("onboarding")
}

model AdditionalVerification {
  id                  String   @id
  applicationId       String   @map("application_id")
  type                String
  status              String
  selfieDocumentId    String?  @map("selfie_document_id")
  referenceDocumentId String?  @map("reference_document_id")
  providerSessionId   String?  @map("provider_session_id")
  exemptionBasis      String?  @map("exemption_basis")
  livenessScore       Float?   @map("liveness_score")
  faceMatchConfidence Float?   @map("face_match_confidence")
  thresholdVersion    String   @map("threshold_version")
  safeErrorCategory   String?  @map("safe_error_category")
  createdAt           DateTime @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([applicationId])
  @@map("additional_verifications")
  @@schema("onboarding")
}

model Task {
  id            String    @id
  applicationId String    @map("application_id")
  category      String
  status        String
  details       Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz

  @@index([applicationId, status])
  @@map("tasks")
  @@schema("onboarding")
}

// ---------------- onboarding: profile, declarations, bank, nomination (phase 4) ----------------

model CustomerProfile {
  applicationId              String   @map("application_id")
  version                    Int
  occupation                 String
  annualIncomeBand           String   @map("annual_income_band")
  sourceOfFunds              Json     @map("source_of_funds")
  sourceOfFundsExplanation   Bytes?   @map("source_of_funds_explanation")
  evidenceRequired           Boolean  @map("evidence_required")
  savedAt                    DateTime @map("saved_at") @db.Timestamptz

  @@id([applicationId, version])
  @@map("customer_profiles")
  @@schema("onboarding")
}

model Declaration {
  applicationId                 String   @map("application_id")
  version                       Int
  taxResidencies                Bytes    @map("tax_residencies")
  pepDeclaration                String   @map("pep_declaration")
  declarationVersion            String   @map("declaration_version")
  additionalInformationRequired Boolean  @map("additional_information_required")
  attestedAt                    DateTime @map("attested_at") @db.Timestamptz

  @@id([applicationId, version])
  @@map("declarations")
  @@schema("onboarding")
}

model BankAccount {
  id                 String   @id
  applicationId      String   @map("application_id")
  accountCiphertext  Bytes    @map("account_ciphertext")
  accountFingerprint String   @map("account_fingerprint")
  ifsc               String
  holderName         String   @map("holder_name")
  version            Int
  createdAt          DateTime @map("created_at") @db.Timestamptz

  @@index([applicationId, accountFingerprint])
  @@map("bank_accounts")
  @@schema("onboarding")
}

model BankVerification {
  id                String   @id
  applicationId     String   @map("application_id")
  bankAccountId     String   @map("bank_account_id")
  status            String
  requiredActions   Json     @map("required_actions")
  providerReference String?  @map("provider_reference")
  evidenceKey       String?  @map("evidence_key")
  safeErrorCategory String?  @map("safe_error_category")
  createdAt         DateTime @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([applicationId, status])
  @@map("bank_verifications")
  @@schema("onboarding")
}

model Nomination {
  applicationId      String   @map("application_id")
  version            Int
  choice             String
  allocationMode     String?  @map("allocation_mode")
  nomineesCiphertext Bytes    @map("nominees_ciphertext")
  nomineeCount       Int      @map("nominee_count")
  registrationStatus String   @map("registration_status")
  savedAt            DateTime @map("saved_at") @db.Timestamptz

  @@id([applicationId, version])
  @@map("nominations")
  @@schema("onboarding")
}

// ---------------- compliance (restricted) ----------------

model ScreeningRun {
  id                      String    @id
  applicationId           String    @map("application_id")
  identityVersion         Int       @map("identity_version")
  screeningPolicyVersion  String    @map("screening_policy_version")
  status                  String
  suggestedAction         String?   @map("suggested_action")
  providerRequestId       String?   @map("provider_request_id")
  evidenceKey             String?   @map("evidence_key")
  safeErrorCategory       String?   @map("safe_error_category")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  completedAt             DateTime? @map("completed_at") @db.Timestamptz

  @@index([applicationId, status])
  @@index([status])
  @@map("screening_runs")
  @@schema("compliance")
}

model AmlAssessment {
  id                 String    @id
  applicationId      String    @map("application_id")
  identityVersion    Int       @map("identity_version")
  profileVersion     Int       @map("profile_version")
  declarationVersion Int       @map("declaration_version")
  policyVersion      String    @map("policy_version")
  status             String
  riskValue          String?   @map("risk_value")
  nextReviewDate     DateTime? @map("next_review_date") @db.Date
  providerRequestId  String?   @map("provider_request_id")
  evidenceKey        String?   @map("evidence_key")
  safeErrorCategory  String?   @map("safe_error_category")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  completedAt        DateTime? @map("completed_at") @db.Timestamptz

  @@index([applicationId, status])
  @@index([status])
  @@map("aml_assessments")
  @@schema("compliance")
}

// ---------------- phase 5: suitability, approach, fees, acknowledgements, review ----------------

model SuitabilityAssessment {
  id                     String   @id
  applicationId          String   @map("application_id")
  version                Int
  questionnaireVersion   String   @map("questionnaire_version")
  answers                Json
  status                 String
  score                  Int?
  riskProfile            String?  @map("risk_profile")
  permittedApproachCodes Json     @map("permitted_approach_codes")
  missingQuestionIds     Json     @map("missing_question_ids")
  createdAt              DateTime @map("created_at") @db.Timestamptz

  @@unique([applicationId, version])
  @@map("suitability_assessments")
  @@schema("onboarding")
}

model InvestmentApproach {
  applicationId     String   @map("application_id")
  version           Int
  assessmentId      String   @map("assessment_id")
  assessmentVersion Int      @map("assessment_version")
  approachCode      String   @map("approach_code")
  confirmedAt       DateTime @map("confirmed_at") @db.Timestamptz

  @@id([applicationId, version])
  @@map("investment_approaches")
  @@schema("onboarding")
}

model FeeIllustration {
  id                 String   @id
  applicationId      String   @map("application_id")
  approachCode       String   @map("approach_code")
  feeScheduleVersion String   @map("fee_schedule_version")
  scenarioCode       String   @map("scenario_code")
  disclaimerVersion  String   @map("disclaimer_version")
  assumptions        Json
  lineItems          Json     @map("line_items")
  createdAt          DateTime @map("created_at") @db.Timestamptz

  @@index([applicationId])
  @@map("fee_illustrations")
  @@schema("onboarding")
}

model Acknowledgement {
  applicationId                String   @map("application_id")
  version                      Int
  documentPackVersion          Int      @map("document_pack_version")
  items                        Json
  feeUnderstandingNote         Bytes    @map("fee_understanding_note")
  feeAnnexureExecutionRequired Boolean  @map("fee_annexure_execution_required")
  recordedAt                   DateTime @map("recorded_at") @db.Timestamptz

  @@id([applicationId, version])
  @@map("acknowledgements")
  @@schema("onboarding")
}

model ReviewSnapshot {
  id                          String   @id
  applicationId               String   @map("application_id")
  confirmedApplicationVersion Int      @map("confirmed_application_version")
  applicationVersion          Int      @map("application_version")
  documentPackVersion         Int      @map("document_pack_version")
  sections                    Json
  hash                        String
  status                      String
  confirmedAt                 DateTime @map("confirmed_at") @db.Timestamptz

  @@index([applicationId, status])
  @@map("review_snapshots")
  @@schema("onboarding")
}

// ---------------- phase 6: signing, account opening, funding, activation ----------------

model SigningSession {
  id                  String    @id
  applicationId       String    @map("application_id")
  snapshotId          String    @map("snapshot_id")
  documentPackVersion Int       @map("document_pack_version")
  signingMethod       String    @map("signing_method")
  status              String
  providerRequestId   String?   @map("provider_request_id")
  packObjectKey       String    @map("pack_object_key")
  packSha256          String    @map("pack_sha256")
  documents           Json
  pollCount           Int       @default(0) @map("poll_count")
  lastProviderStatus  String?   @map("last_provider_status")
  safeErrorCategory   String?   @map("safe_error_category")
  evidenceKey         String?   @map("evidence_key")
  createdAt           DateTime  @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  executedAt          DateTime? @map("executed_at") @db.Timestamptz

  @@index([applicationId, status])
  @@index([providerRequestId])
  @@index([snapshotId])
  @@map("signing_sessions")
  @@schema("onboarding")
}

model AccountOpeningRun {
  id                  String    @id
  applicationId       String    @map("application_id")
  snapshotId          String    @map("snapshot_id")
  documentPackVersion Int       @map("document_pack_version")
  status              String
  blockers            Json
  createdAt           DateTime  @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  completedAt         DateTime? @map("completed_at") @db.Timestamptz

  @@index([applicationId, status])
  @@map("account_opening_runs")
  @@schema("onboarding")
}

model RegistrySubmission {
  id                 String    @id
  applicationId      String    @map("application_id")
  runId              String    @map("run_id")
  registry           String
  status             String
  basis              String?
  providerRequestId  String?   @map("provider_request_id")
  clientReferenceId  String?   @map("client_reference_id")
  lastProviderStatus String?   @map("last_provider_status")
  deadlineAt         DateTime? @map("deadline_at") @db.Timestamptz
  evidenceKey        String?   @map("evidence_key")
  safeErrorCategory  String?   @map("safe_error_category")
  createdAt          DateTime  @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([applicationId, registry])
  @@index([providerRequestId])
  @@index([clientReferenceId])
  @@map("registry_submissions")
  @@schema("onboarding")
}

model UnderlyingAccount {
  id                 String   @id
  applicationId      String   @map("application_id")
  providerReceiptKey String   @unique @map("provider_receipt_key")
  provider           String
  accountType        String   @map("account_type")
  accountReference   String   @map("account_reference")
  status             String
  receivedAt         DateTime @map("received_at") @db.Timestamptz

  @@index([applicationId, accountType])
  @@map("underlying_accounts")
  @@schema("onboarding")
}

model FundingNotification {
  id                        String   @id
  applicationId             String   @map("application_id")
  fundingMethod             String   @map("funding_method")
  customerTransferReference Bytes    @map("customer_transfer_reference")
  createdAt                 DateTime @map("created_at") @db.Timestamptz

  @@index([applicationId])
  @@map("funding_notifications")
  @@schema("onboarding")
}

model FundingReceipt {
  id                       String   @id
  applicationId            String   @map("application_id")
  providerReceiptKey       String   @unique @map("provider_receipt_key")
  provider                 String
  amountInr                BigInt   @map("amount_inr")
  currency                 String
  sourceAccountFingerprint String?  @map("source_account_fingerprint")
  destinationReference     String   @map("destination_reference")
  valueDate                String   @map("value_date")
  matchStatus              String   @map("match_status")
  mismatchReasons          Json     @map("mismatch_reasons")
  receivedAt               DateTime @map("received_at") @db.Timestamptz

  @@index([applicationId, matchStatus])
  @@map("funding_receipts")
  @@schema("onboarding")
}

model Activation {
  id            String   @id
  applicationId String   @unique @map("application_id")
  pmsAccountId  String   @map("pms_account_id")
  gateSnapshot  Json     @map("gate_snapshot")
  activatedAt   DateTime @map("activated_at") @db.Timestamptz

  @@map("activations")
  @@schema("onboarding")
}

model TaskResponse {
  id           String   @id
  taskId       String   @map("task_id")
  applicationId String  @map("application_id")
  responseType String   @map("response_type")
  documentIds  Json     @map("document_ids")
  text         Bytes?
  submittedAt  DateTime @map("submitted_at") @db.Timestamptz

  @@index([taskId])
  @@map("task_responses")
  @@schema("onboarding")
}
